# Copy to .env and fill in. Never commit .env.

# --- Chat platforms (new bots, separate from the EVM/Solana Protean bot) ---
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Register slash commands to one test server first
DISCORD_GUILD_ID=

# --- NEAR ---
NEAR_NETWORK=testnet
# Optional. Defaults to free public RPCs that need no key: dRPC, then Intear
# (near-testnet.drpc.org, testnet-rpc.intea.rs on testnet). NEAR's own
# rpc.*.near.org is deprecated. List several, comma-separated, to fall back
# from one to the next; a provider key can go in the URL, and logs blank it.
NEAR_RPC_URL=
# Pays gas and account-creation deposits, and is the parent of user accounts
NEAR_OPERATOR_ACCOUNT_ID=
NEAR_OPERATOR_PRIVATE_KEY=
# Sputnik factory: sputnikv2.testnet / sputnik-dao.near (official), or Protean's own,
# sputnik.<operator>, from scripts/deploy-factory.js (then DAO_CREATE_DEPOSIT=0.1)
SPUTNIK_FACTORY_ID=sputnikv2.testnet
# NEAR given to each new user account, and the balance below which it's topped back up
NEW_ACCOUNT_NEAR=0.05
MIN_ACCOUNT_NEAR=0.02
# NEAR sent with a new DAO (/createdao). sputnikv2.testnet stores the whole DAO
# contract per DAO and needs about 5.4; a factory with global contracts needs
# only 0.01. What isn't used stays in the treasury.
DAO_CREATE_DEPOSIT=6

# --- Notifications: the bot posts when voting ends and a proposal can be
# executed; how often it checks, in seconds (0 turns them off) ---
NOTIFY_SECONDS=60

# --- Governance timing for new DAOs (minutes); short defaults suit a demo ---
VOTING_PERIOD_MINUTES=60
VOTING_DELAY_MINUTES=0
TIMELOCK_MINUTES=1
EXECUTION_WINDOW_MINUTES=4320
CHALLENGE_MINUTES=60
TERM_MINUTES=10080
CANDIDACY_MINUTES=30
ELECTION_MINUTES=60
RECALL_MINUTES=60
# Sowellian: positions window, measurement after execution, adjudication, oracle freshness
POSITIONS_MINUTES=60
MEASUREMENT_MINUTES=60
ADJUDICATION_MINUTES=60
ORACLE_STALENESS_MINUTES=60
# Decision markets: trading window, and how far pass must beat fail (basis points)
TRADING_MINUTES=60
MARKET_THRESHOLD_BPS=100
# Shares, in basis points (10000 = 100%)
QUORUM_BPS=2000
APPROVAL_BPS=5000

# --- NEAR Intents (mainnet) ---
# Optional 1Click API token; without it 1Click charges a small fee per swap
ONECLICK_JWT=

# --- Chain Signatures and Base (the DAO's own EVM address) ---
# Defaults: v1.signer (mainnet), v1.signer-prod.testnet (testnet); Base or Base
# Sepolia's public RPC, then PublicNode's. BASE_RPC_URL may list several, comma-separated
CHAIN_SIGNER_ID=
BASE_RPC_URL=
# Hyperliquid's API; defaults to mainnet with NEAR mainnet, its testnet otherwise
HYPERLIQUID_API=

# --- Wallet encryption (AWS KMS) ---
# The same key as the EVM bot, used by this bot's own IAM user, which may only
# use it with encryption context {"app": "protean-near"}.
KMS_KEY_ID=
# The key's region; KMS keys only work in their own region
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Storage (this project's own Supabase; run supabase/schema.sql once) ---
# Chat links in Supabase instead of a local file (needs the chat_links table)
CHAT_LINKS_STORE=supabase
SUPABASE_URL=
# service_role key: every table has RLS on with no policies
SUPABASE_SERVICE_ROLE_KEY=
