# Copy to .env and fill in. Never commit .env.

# --- Chat platforms (new bots, separate from the EVM/Solana Protean bot) ---
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Register slash commands to one test server first
DISCORD_GUILD_ID=

# --- NEAR ---
NEAR_NETWORK=testnet
# Optional: your own RPC provider; the public one rate-limits
NEAR_RPC_URL=
# Pays gas and account-creation deposits, and is the parent of user accounts
NEAR_OPERATOR_ACCOUNT_ID=
NEAR_OPERATOR_PRIVATE_KEY=
# Official Sputnik factory: sputnikv2.testnet on testnet, sputnik-dao.near on mainnet
SPUTNIK_FACTORY_ID=sputnikv2.testnet
# NEAR given to each new user account, and the balance below which it's topped back up
NEW_ACCOUNT_NEAR=0.05
MIN_ACCOUNT_NEAR=0.02
# NEAR sent with a new DAO (scripts/deploy-dao.js); 0.01 is enough for a factory with
# global contracts, an older factory needs about 6. What's left stays in the treasury.
DAO_CREATE_DEPOSIT=0.1

# --- Wallet encryption (AWS KMS) ---
# The same key as the EVM bot, used by this bot's own IAM user, which may only
# use it with encryption context {"app": "protean-near"}.
KMS_KEY_ID=
# The key's region; KMS keys only work in their own region
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Storage (this project's own Supabase; run supabase/schema.sql once) ---
# Chat links in Supabase instead of a local file (needs the chat_links table)
CHAT_LINKS_STORE=supabase
SUPABASE_URL=
# service_role key: every table has RLS on with no policies
SUPABASE_SERVICE_ROLE_KEY=
